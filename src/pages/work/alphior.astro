---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Alphior — Ali Zhetpis" homeHref="/" workHref="/#work">
  <main class="cs-main">

    <!-- ── Hero ── -->
    <section class="cs-page" id="top">
      <div style="display:flex; flex-direction:column; gap:80px; width:100%;">
        <div class="cs-row">
          <div class="cs-col-left">
            <a href="/" class="cs-back">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4L12 20M12 4L6 10M12 4L18 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Back
            </a>
          </div>
          <div class="cs-col-right">
            <img src="/assets/logo-alphior.svg" data-light="/assets/logo-alphior.svg" data-dark="/assets/logo-alphior-dark.svg" alt="Alphior icon" class="cs-icon" />
            <div style="display:flex; flex-direction:column; gap:8px;">
              <p class="cs-heading">Alphior</p>
              <p class="cs-desc">B2B web platform for HR electronic document management: payslips, leave requests, and multi-step approvals for outsourcing clients across Central Asia</p>
            </div>
            <div class="cs-meta">
              <div class="cs-meta-row">
                <span class="cs-meta-label">Period</span>
                <span class="cs-meta-value">2025 · 3 months</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Role</span>
                <span class="cs-meta-value">Product Designer</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Scope</span>
                <span class="cs-meta-value">Research, UI/UX, UX Writing, CJM, Design System, Prototyping</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Type</span>
                <span class="cs-meta-value">Web SaaS · B2B</span>
              </div>
            </div>
          </div>
        </div>

        <div class="al-hero-visual al-reveal">
          <div class="al-hero-visual__logo">
            <img src="/assets/alphior/wordmark.svg" alt="Alphior — Business Partners" />
          </div>
          <div class="al-hero-visual__shot">
            <img src="/assets/alphior/hero-macbook.webp" alt="Alphior admin platform on a MacBook" />
          </div>
        </div>
      </div>
    </section>

    <!-- ── Context ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Context</p>
        <div class="al-facts al-reveal">
          <div><p class="al-facts__text">Every leave request routed through corporate email</p><p class="al-facts__label">Manual</p></div>
          <div><p class="al-facts__text">Orders generated and chased inside 1C</p><p class="al-facts__label">1C-bound</p></div>
          <div><p class="al-facts__text">Routes set up by hand for each new client</p><p class="al-facts__label">Multi-client</p></div>
          <div><p class="al-facts__text">Employees, managers, admins, all in one system</p><p class="al-facts__label">Multi-role</p></div>
        </div>
      </div>
    </section>

    <!-- ── Problem statement ── -->
    <section class="cs-page al-block-blue al-block-blue--photo">
      <div class="al-statement al-reveal">
        <p class="al-statement__label">Problem statement</p>
        <div class="al-statement__body">
          <p class="al-statement__title">HR teams lose time routing documents by hand</p>
          <p class="al-statement__desc">Leave requests, approvals, and payslips moved through email and 1C, needing manual setup for every route and client, so simple tasks stalled across departments</p>
        </div>
      </div>
    </section>

    <!-- ── Jobs To Be Done ── -->
    <section class="cs-page al-jt-section">
      <div class="cs-stack al-jt-stack">
        <img class="al-jt-quote" src="/assets/alphior/jtbd-quote.svg" alt="" />
        <p class="cs-section-heading al-reveal">Jobs To Be Done</p>
        <div class="al-jt al-reveal">
          <div><p class="al-jt__role">EMPLOYEE</p><p class="al-jt__text">When I need my payslip or want to request leave, I want to do it in a couple of clicks, so I don't wait on HR or email.</p></div>
          <div><p class="al-jt__role">MANAGER</p><p class="al-jt__text">When a request reaches me, I want to see my team's hierarchy and approve in place, so approvals don't stall.</p></div>
          <div><p class="al-jt__role">ADMIN</p><p class="al-jt__text">When client data changes, I want to fix it and reroute approvals myself, so the system runs without email.</p></div>
        </div>
      </div>
    </section>

    <!-- ── Permissions were the architecture (Roles) ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Permissions were the architecture</p>
        <div class="al-roles al-reveal">
          <div class="al-role-card">
            <div class="al-dots"><i class="al-on"></i><i></i><i></i><i></i></div>
            <div class="al-role-card__text">
              <p class="al-role-card__name">Employee</p>
              <p class="al-role-card__desc">Own profile: payslips, data, leave</p>
            </div>
          </div>
          <div class="al-role-card">
            <div class="al-dots"><i class="al-on"></i><i class="al-on"></i><i></i><i></i></div>
            <div class="al-role-card__text">
              <p class="al-role-card__name">Manager</p>
              <p class="al-role-card__desc">Approves and delegates across their team tree</p>
            </div>
          </div>
          <div class="al-role-card">
            <div class="al-dots"><i class="al-on"></i><i class="al-on"></i><i class="al-on"></i><i></i></div>
            <div class="al-role-card__text">
              <p class="al-role-card__name">Admin</p>
              <p class="al-role-card__desc">Edits anyone, reroutes approvals, runs the portal</p>
            </div>
          </div>
          <div class="al-role-card">
            <div class="al-dots"><i class="al-on"></i><i class="al-on"></i><i class="al-on"></i><i class="al-on"></i></div>
            <div class="al-role-card__text">
              <p class="al-role-card__name">Super-admin</p>
              <p class="al-role-card__desc">Full control across all portals</p>
            </div>
          </div>
          <div class="al-role-card">
            <img class="al-star" src="/assets/alphior/icon-north-star.svg" alt="" />
            <div class="al-role-card__text">
              <p class="al-role-card__name">Specialist</p>
              <p class="al-role-card__desc">Separate desk for client requests and tickets</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Competitive teardown ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Competitive teardown</p>
        <div class="al-comp al-reveal">
          <div>
            <div class="al-comp__text">
              <p class="al-comp__title">Direct · EDM / HR</p>
              <p class="al-comp__desc">Strong reach, but recurring pains. No mass signing, rigid approval routes, dated interfaces, hard navigation.</p>
            </div>
            <span class="al-pill">5 competitors</span>
          </div>
          <div class="al-comp__divider"></div>
          <div>
            <div class="al-comp__text">
              <p class="al-comp__title">Indirect</p>
              <p class="al-comp__desc">Clean UIs, but each solves one slice: time, accounting, or talent, not the payroll-to-approval loop.</p>
            </div>
            <span class="al-pill">4 competitors</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Pull quote ── -->
    <section class="cs-page">
      <p class="al-pullquote al-reveal">The gap. No one made document routing and approvals feel effortless. That became <span class="al-pullquote__highlight">the bet.</span></p>
    </section>

    <!-- ── Scope (flip cards) ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Scope</p>
        <div class="al-phases al-reveal">
          <button type="button" class="al-phase" aria-pressed="false">
            <span class="al-phase__inner">
              <span class="al-phase__face al-phase__front">
                <span class="al-phase__tag">Phase 1 · MVP</span>
                <span class="al-phase__word">Access</span>
              </span>
              <span class="al-phase__face al-phase__back">
                <img class="al-phase__num" src="/assets/alphior/phase-num-1.svg" alt="" style="right:-10px; bottom:-20px; height:80%; width:auto;" />
                <ul><li>Login and 2FA</li><li>Payslip access</li><li>24-month history</li><li>Export / share</li></ul>
              </span>
            </span>
          </button>
          <button type="button" class="al-phase" aria-pressed="false">
            <span class="al-phase__inner">
              <span class="al-phase__face al-phase__front">
                <span class="al-phase__tag">Phase 2</span>
                <span class="al-phase__word">Approvals</span>
              </span>
              <span class="al-phase__face al-phase__back">
                <img class="al-phase__num" src="/assets/alphior/phase-num-2.svg" alt="" style="right:-10px; bottom:-20px; height:80%; width:auto;" />
                <ul><li>Document routing</li><li>Multi-step approvals</li><li>Roles and permissions</li><li>Specialist tickets</li></ul>
              </span>
            </span>
          </button>
          <button type="button" class="al-phase" aria-pressed="false">
            <span class="al-phase__inner">
              <span class="al-phase__face al-phase__front">
                <span class="al-phase__tag">Phase 3</span>
                <span class="al-phase__word">Lifecycle</span>
              </span>
              <span class="al-phase__face al-phase__back">
                <img class="al-phase__num" src="/assets/alphior/phase-num-3.svg" alt="" style="right:-10px; bottom:-20px; height:80%; width:auto;" />
                <ul><li>Full hire-to-exit</li><li>Candidate offer</li><li>Onboarding</li><li>Termination</li></ul>
              </span>
            </span>
          </button>
        </div>
      </div>
    </section>

    <!-- ── Screens ── -->
    <section class="cs-page al-screens-section">
      <div class="al-screens-layout">
        <div class="al-screens-heading-col">
          <div class="al-screens-heading-sticky">
            <p class="cs-section-heading al-reveal al-screens-heading">Screens</p>
          </div>
        </div>
        <div class="al-screens-list">
          <div class="al-screen al-reveal" data-caption="One line in, you're in">
            <img class="al-screen__img" src="/assets/alphior/screen-authorization.webp" alt="Alphior login screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="Everything about you, one glance">
            <img class="al-screen__img" src="/assets/alphior/screen-personal-cabinet-1.webp" alt="Alphior personal cabinet screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="Paperwork that finds you first">
            <img class="al-screen__img" src="/assets/alphior/screen-personal-cabinet-2.webp" alt="Alphior employment documents screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="Approvals, out in the open">
            <img class="al-screen__img" src="/assets/alphior/screen-requests.webp" alt="Alphior requests board screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="Requests, starting with Hiring">
            <img class="al-screen__img" src="/assets/alphior/screen-hiring.webp" alt="Alphior create hiring request screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="Every client, one table">
            <img class="al-screen__img" src="/assets/alphior/screen-companies.webp" alt="Alphior companies table screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="Every status change, on the record">
            <img class="al-screen__img" src="/assets/alphior/screen-approval-history.webp" alt="Alphior application approval history screen" />
          </div>
          <div class="al-screen al-reveal" data-caption="All their paperwork, one download">
            <img class="al-screen__img" src="/assets/alphior/screen-employee-documents.webp" alt="Alphior employee documents screen" />
          </div>
        </div>
      </div>
      <p class="al-screens-caption is-text-visible" id="al-screens-caption">One line in, you're in</p>
    </section>

    <!-- ── Design principle ── -->
    <section class="cs-page al-block-blue">
      <div class="al-statement al-reveal">
        <p class="al-statement__label">Design principle</p>
        <div class="al-statement__body">
          <p class="al-statement__title">Minimize clicks. Maximize clarity</p>
          <p class="al-statement__desc">Every flow was measured by one rule: the fewest clicks from intent to done.<br>A payslip is one click. Leave is a request, not a thread.<br>Approvals happen where the manager already is</p>
        </div>
      </div>
    </section>

    <!-- ── Typography ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Typography</p>
        <div class="al-type-row al-reveal">
          <div class="al-type-card">
            <div class="al-type-card__weights"><span>Regular</span><span>Medium</span><span>Semibold</span><span>Bold</span></div>
            <p class="al-type-card__specimen">Inter</p>
          </div>
          <div class="al-type-card al-type-card--dark">
            <p class="al-type-card__sample">AaBbCc<br />01234567<br />{`{(!@#$%&*?)}`}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Colors ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Colors</p>
        <div class="al-swatches al-reveal">
          <div style="background:#ffffff; color:#222;"><span>#FFFFFF</span></div>
          <div style="background:#f8fafc; color:#222;"><span>#F8FAFC</span></div>
          <div style="background:#2563eb; color:#fff;"><span>#2563EB</span></div>
          <div style="background:#14b8a6; color:#fff;"><span>#14B8A6</span></div>
          <div style="background:#6b7280; color:#fff;"><span>#6B7280</span></div>
          <div style="background:#17253f; color:#fff;"><span>#17253F</span></div>
          <div style="background:#1f2937; color:#fff;"><span>#1F2937</span></div>
        </div>
      </div>
    </section>

    <!-- ── Reflection ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading al-reveal">Reflection</p>
        <div class="al-refl al-reveal">
          <div><p class="al-refl__title">Model the roles first</p><p class="al-refl__desc">Permissions weren't a detail, they were the architecture. Getting the role model right made every screen simpler.</p></div>
          <div><p class="al-refl__title">Benchmark for gaps</p><p class="al-refl__desc">The market had reach and dated UX. Fixing the approval loop, not adding modules, was the opening.</p></div>
          <div><p class="al-refl__title">Phase ruthlessly</p><p class="al-refl__desc">Payslips first gave clients value fast; approvals and lifecycle could follow without blocking launch.</p></div>
        </div>
      </div>
    </section>

    <!-- ── Closing ── -->
    <section class="cs-page cs-page--closing">
      <div class="al-closing-wrap">
        <div class="al-closing al-reveal">
          <div class="al-closing__spacer"></div>
          <p class="al-closing__text">Thanks</p>
          <button type="button" class="al-closing__heart-btn" aria-label="Send some love">
            <img src="/assets/energo/v2/icon-heart-v3.svg" alt="" class="al-closing__heart" />
          </button>
          <p class="al-closing__text">for watching</p>
        </div>

        <div class="al-closing-cta al-reveal">
          <div class="al-closing__spacer"></div>
          <p class="al-closing-cta__text">See what else I've built</p>
        </div>

        <div class="al-portfolio-teaser al-reveal">
          <a href="/work/energo" class="al-portfolio-teaser__card" style="background:var(--energo-green);" data-cursor="See Case">
            <div class="al-portfolio-teaser__watermark"><img src="/assets/logo-energo.svg" alt="" /></div>
            <div class="al-portfolio-teaser__title">
              <p class="al-portfolio-teaser__name">EnerGo</p>
              <p class="al-portfolio-teaser__sub">B2C · EV · Mobile</p>
            </div>
          </a>
          <a href="/#aci" class="al-portfolio-teaser__card" style="background:#007395;" data-cursor="Sorry, NDA">
            <div class="al-portfolio-teaser__watermark"><img src="/assets/logo-aci.svg" alt="" /></div>
            <div class="al-portfolio-teaser__title">
              <p class="al-portfolio-teaser__name">Alatau City Invest</p>
              <p class="al-portfolio-teaser__sub">B2C/B2B · Fintech · Investments</p>
            </div>
          </a>
          <a href="/#citix" class="al-portfolio-teaser__card" style="background:#D10D35;" data-cursor="Drop Soon">
            <div class="al-portfolio-teaser__watermark"><img src="/assets/logo-citix-mark.svg" alt="" /></div>
            <div class="al-portfolio-teaser__title">
              <p class="al-portfolio-teaser__name">Citix</p>
              <p class="al-portfolio-teaser__sub">B2B · Adtech · SaaS</p>
            </div>
          </a>
          <a href="/#bereke" class="al-portfolio-teaser__card" style="background:#023DFF;" data-cursor="Drop Soon">
            <div class="al-portfolio-teaser__watermark"><img src="/assets/logo-bereke.svg" alt="" /></div>
            <div class="al-portfolio-teaser__title">
              <p class="al-portfolio-teaser__name">Bereke Bank</p>
              <p class="al-portfolio-teaser__sub">B2C/B2B · Fintech · Transfers &amp; Payments</p>
            </div>
          </a>
          <a href="/#sberbank" class="al-portfolio-teaser__card" style="background:#21A038;" data-cursor="Sorry, NDA">
            <div class="al-portfolio-teaser__watermark"><img src="/assets/sberbank.svg" alt="" /></div>
            <div class="al-portfolio-teaser__title">
              <p class="al-portfolio-teaser__name">Sberbank</p>
              <p class="al-portfolio-teaser__sub">B2C · Fintech · Non-banking services</p>
            </div>
          </a>
          <a href="/#aipark" class="al-portfolio-teaser__card" style="background:#045B2C;" data-cursor="Drop Soon">
            <div class="al-portfolio-teaser__watermark"><img src="/assets/logo-aipark.svg" alt="" /></div>
            <div class="al-portfolio-teaser__title">
              <p class="al-portfolio-teaser__name">AI Parking</p>
              <p class="al-portfolio-teaser__sub">B2C · Parking · Mobile</p>
            </div>
          </a>
        </div>
      </div>
    </section>

  </main>

  <div class="cursor-pill" id="alCursorPill"><span id="alCursorLabel">See Case</span></div>

  <Fragment slot="scripts">
    <script is:inline>
      // ── Pull quote word-by-word reveal ─────────────
      const pullquote = document.querySelector('.al-pullquote');
      if (pullquote) {
        // Astro's scoped-style attribute (data-astro-cid-*) is only
        // stamped onto elements present at build time — spans created
        // here at runtime need it copied over manually, or the scoped
        // .al-pullquote__word rules below silently never match them.
        const cidAttr = pullquote.getAttributeNames().find(a => a.startsWith('data-astro-cid'));
        let wi = 0;
        const wrapWords = (container) => {
          [...container.childNodes].forEach(node => {
            if (node.nodeType === Node.TEXT_NODE) {
              const frag = document.createDocumentFragment();
              node.textContent.split(/(\s+)/).forEach(part => {
                if (part.trim() === '') {
                  frag.appendChild(document.createTextNode(part));
                } else {
                  const span = document.createElement('span');
                  span.className = 'al-pullquote__word';
                  if (cidAttr) span.setAttribute(cidAttr, '');
                  span.style.setProperty('--i', wi++);
                  span.textContent = part;
                  frag.appendChild(span);
                }
              });
              node.replaceWith(frag);
            } else if (node.nodeType === Node.ELEMENT_NODE) {
              // e.g. the "the bet." highlight span — split its own text
              // into words too, so it animates in step with the rest
              // instead of landing as one fixed chunk.
              wrapWords(node);
            }
          });
        };
        wrapWords(pullquote);
      }

      observeReveal([...document.querySelectorAll('.al-reveal')], { threshold: 0.08, rootMargin: '0px 0px -50px 0px' });

      // The shared Footer component ships with its own opacity:0 base
      // style (style.css) meant to be cleared by observeReveal — every
      // page using the Footer must trigger this itself.
      const footerEl = document.querySelector('.footer');
      if (footerEl) observeReveal([footerEl], { threshold: 0.04 });

      // ── Scope card flip ────────────────────────────
      document.querySelectorAll('.al-phase').forEach(card => {
        card.addEventListener('click', () => {
          card.setAttribute('aria-pressed', card.getAttribute('aria-pressed') !== 'true');
        });
        card.addEventListener('mouseleave', () => {
          card.setAttribute('aria-pressed', 'false');
        });
      });

      // ── Hero shot parallax ──────────────────────────
      const heroShotImg = document.querySelector('.al-hero-visual__shot img');
      const heroShotPanel = document.querySelector('.al-hero-visual__shot');
      if (heroShotImg && heroShotPanel) {
        const amount = 40;
        const updateHeroParallax = () => {
          const vh = window.innerHeight;
          const rect = heroShotPanel.getBoundingClientRect();
          const progress = (rect.top + rect.height / 2 - vh / 2) / vh;
          heroShotImg.style.transform = `translateY(${progress * amount}px)`;
        };
        window.lenis.on('scroll', updateHeroParallax);
        updateHeroParallax();
      }

      // ── Screens fixed caption (scroll-synced) ───────
      const screenEls = document.querySelectorAll('.al-screen');
      const captionEl = document.getElementById('al-screens-caption');
      const screensLayoutEl = document.querySelector('.al-screens-layout');
      if (screenEls.length && captionEl && screensLayoutEl) {
        let currentCaption = captionEl.textContent;
        const activeScreens = new Set();
        const setCaption = (text) => {
          if (text === currentCaption) return;
          currentCaption = text;
          captionEl.textContent = text;
        };
        const screenObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              activeScreens.add(entry.target);
              setCaption(entry.target.dataset.caption);
            } else {
              activeScreens.delete(entry.target);
            }
          });
          captionEl.classList.toggle('has-active-screen', activeScreens.size > 0);
        }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
        screenEls.forEach(el => screenObserver.observe(el));

        // Shows only while the actual content row (heading + frames, not
        // the section's own padding) spans the caption's vertical position
        // — symmetric for both scroll directions, so it fades in/out
        // cleanly right as real content appears/leaves, not before/after.
        const firstCaption = screenEls[0].dataset.caption;
        let lastScrollY = window.scrollY;
        let wasInSection = false;
        const onScroll = () => {
          const rect = screensLayoutEl.getBoundingClientRect();
          const centerLine = window.innerHeight / 2;
          const inSection = rect.top <= centerLine && rect.bottom >= centerLine;
          const scrollingUp = window.scrollY < lastScrollY;

          // Exiting upward (back toward the section's start) while still
          // showing the very first caption should cut instantly, not fade
          // — the fade reads as lag right as the page leaves the section.
          if (wasInSection && !inSection && scrollingUp && currentCaption === firstCaption) {
            captionEl.classList.add('is-cutting');
            captionEl.classList.remove('is-in-section');
            requestAnimationFrame(() => captionEl.classList.remove('is-cutting'));
          } else {
            captionEl.classList.toggle('is-in-section', inSection);
          }

          wasInSection = inSection;
          lastScrollY = window.scrollY;
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // ── Closing heart burst ────────────────────────
      const heartBtn = document.querySelector('.al-closing__heart-btn');
      if (heartBtn) {
        heartBtn.addEventListener('click', () => {
          const count = 8;
          for (let i = 0; i < count; i++) {
            const particle = document.createElement('span');
            particle.className = 'al-closing__particle';
            const angle = (Math.PI * 2 * i) / count + (Math.random() * 0.4 - 0.2);
            const distance = 60 + Math.random() * 40;
            particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
            particle.style.setProperty('--dy', `${Math.sin(angle) * distance - 20}px`);
            particle.style.animationDelay = `${Math.random() * 80}ms`;
            heartBtn.appendChild(particle);
            particle.addEventListener('animationend', () => particle.remove());
          }
        });
      }

      // ── Portfolio teaser: custom cursor pill ────────
      const alPill      = document.getElementById('alCursorPill');
      const alPillLabel = document.getElementById('alCursorLabel');
      if (alPill && alPillLabel) {
        let alPillX = 0, alPillY = 0, alMouseX = 0, alMouseY = 0;
        document.addEventListener('mousemove', e => { alMouseX = e.clientX; alMouseY = e.clientY; });
        (function followAlCursor() {
          alPillX += (alMouseX - alPillX) * 0.18;
          alPillY += (alMouseY - alPillY) * 0.18;
          alPill.style.left = alPillX + 'px';
          alPill.style.top  = alPillY + 'px';
          requestAnimationFrame(followAlCursor);
        })();
        document.querySelectorAll('.al-portfolio-teaser__card').forEach(el => {
          const label = el.dataset.cursor || 'Sorry, NDA';
          el.addEventListener('mouseenter', () => {
            alPillLabel.textContent = label;
            alPill.classList.add('visible');
          });
          el.addEventListener('mouseleave', () => {
            alPill.classList.remove('visible');
            alPillX = alMouseX; alPillY = alMouseY;
          });
        });
      }

      // ── Portfolio teaser: only hijack genuinely horizontal
      // wheel gestures, so vertical page scroll stays smooth
      // and uninterrupted (no Lenis/native handoff stutter).
      const alTeaserRow = document.querySelector('.al-portfolio-teaser');
      if (alTeaserRow) {
        alTeaserRow.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
            e.preventDefault();
            e.stopPropagation();
            alTeaserRow.scrollLeft += e.deltaX;
          }
        }, { passive: false });
      }

      // ── Re-center Thanks/cards on bfcache return ────
      // Clicking a teaser card navigates away from right here; when the
      // user comes back (bfcache restore), re-center this block in the
      // viewport instead of leaving it wherever it happened to land.
      window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        const closingBlock = document.querySelector('.al-closing-wrap');
        if (!closingBlock) return;
        const rect = closingBlock.getBoundingClientRect();
        const wasInView = rect.top < window.innerHeight && rect.bottom > 0;
        if (wasInView) {
          requestAnimationFrame(() => {
            closingBlock.scrollIntoView({ block: 'center', behavior: 'auto' });
            if (window.lenis) {
              window.lenis.isScrolling = false;
              window.lenis.animatedScroll = window.lenis.targetScroll = window.scrollY;
            }
          });
        }
      });
    </script>
  </Fragment>
</Layout>

