---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="EnerGo — Ali Zhetpis" homeHref="/" workHref="/#work">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
  </Fragment>
  <main class="cs-main">

    <!-- ── Hero ── -->
    <section class="cs-page">
      <div style="display:flex; flex-direction:column; gap:80px; width:100%;">
        <div class="cs-row">
          <div class="cs-col-left">
            <a href="/" class="cs-back">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4L12 20M12 4L6 10M12 4L18 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Back
            </a>
          </div>
          <div class="cs-col-right">
            <img src="/assets/energo/icon.svg" alt="EnerGo icon" class="cs-icon" />
            <div style="display:flex; flex-direction:column; gap:8px;">
              <p class="cs-heading">EnerGo</p>
              <p class="cs-desc">A 0→1 charging app for a market where EVs arrived before good software did.<br>Researched, designed, written, and shipped in 3 months</p>
            </div>
            <div class="cs-meta">
              <div class="cs-meta-row">
                <span class="cs-meta-label">Period</span>
                <span class="cs-meta-value">2025 · 3 months</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Role</span>
                <span class="cs-meta-value">Lead Product Designer</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Scope</span>
                <span class="cs-meta-value">Research, UI/UX, UX Writing, CJM, Design System, Prototyping</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Platform</span>
                <span class="cs-meta-value">iOS &amp; Android</span>
              </div>
              <div class="cs-meta-row">
                <span class="cs-meta-label">Link</span>
                <span class="cs-meta-value"><a href="https://energocharge.uz" target="_blank" rel="noopener" class="link-hover">energocharge.uz</a></span>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Photo / wordmark visual ── -->
        <div class="cs-visual-row">
          <div class="cs-visual-panel cs-visual-panel--product">
            <div class="cs-visual-glow" aria-hidden="true"></div>
            <img src="/assets/energo/v2/wordmark-icon.svg" alt="" class="cs-visual-wordmark-icon" />
            <img src="/assets/energo/v2/wordmark-text.svg" alt="EnerGo" class="cs-visual-wordmark-text" />
            <img src="/assets/energo/v2/charging-station.png" alt="EnerGo charging station" class="cs-visual-product" />
          </div>
          <div class="cs-visual-panel cs-visual-panel--phone">
            <img src="/assets/energo/v2/phone-mockup.png" alt="EnerGo app icon on a phone home screen" class="cs-visual-phone" />
          </div>
        </div>
      </div>
    </section>

    <!-- ── Process timeline ── -->
    <section class="cs-page">
      <div class="cs-stack">
        <p class="cs-section-heading">Process</p>
        <div class="cs-process">
          <div class="cs-process__weeks">
            <span>week 1-2</span><span>week 3-4</span><span>week 5-6</span>
            <span>week 7-8</span><span>week 9-10</span><span>week 11-12</span>
          </div>
          <div class="cs-process__track">
            <div class="cs-process__col"></div><div class="cs-process__col"></div><div class="cs-process__col"></div>
            <div class="cs-process__col"></div><div class="cs-process__col"></div><div class="cs-process__col"></div>
            <span class="cs-process__pill" style="left:2%; top:5%; width:30%;"><b class="cs-process__num">1</b>Research</span>
            <span class="cs-process__pill" style="left:20%; top:24%; width:28%;"><b class="cs-process__num">2</b>Ideation</span>
            <span class="cs-process__pill" style="left:35%; top:43%; width:30%;"><b class="cs-process__num">3</b>Wireframes</span>
            <span class="cs-process__pill" style="left:53%; top:62%; width:27%;"><b class="cs-process__num">4</b>Prototype &amp; Testing</span>
            <span class="cs-process__pill" style="left:53%; top:81%; width:47%;"><b class="cs-process__num">5</b>UI Design</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Jobs To Be Done ── -->
    <section class="cs-jtbd">
      <div class="cs-jtbd__inner">
        <p class="cs-jtbd__heading">Jobs To Be Done</p>
        <div class="cs-jtbd__grid">
          <button type="button" class="cs-jtbd__card" aria-pressed="false">
            <span class="cs-jtbd__card-inner">
              <span class="cs-jtbd__card-face cs-jtbd__card-front">
                <p class="cs-jtbd__label">job 1</p>
                <p class="cs-jtbd__text">When running low on charge mid-shift, I want to find the nearest available station in real time, so I don't waste time driving to an occupied spot</p>
                <img src="/assets/energo/v2/jtbd-quote.svg" alt="" class="cs-jtbd__quote" aria-hidden="true" />
              </span>
              <span class="cs-jtbd__card-face cs-jtbd__card-back">
                <p class="cs-jtbd__label">WHY THIS MATTERS</p>
                <p class="cs-jtbd__text">Drivers' #1 frustration: "free" stations that weren't. Solved with live connector status</p>
              </span>
            </span>
          </button>
          <button type="button" class="cs-jtbd__card" aria-pressed="false">
            <span class="cs-jtbd__card-inner">
              <span class="cs-jtbd__card-face cs-jtbd__card-front">
                <p class="cs-jtbd__label">job 2</p>
                <p class="cs-jtbd__text">When planning my route, I want to reserve a specific connector in advance, so I have a guaranteed charging spot when I arrive</p>
                <img src="/assets/energo/v2/jtbd-quote.svg" alt="" class="cs-jtbd__quote" aria-hidden="true" />
              </span>
              <span class="cs-jtbd__card-face cs-jtbd__card-back">
                <p class="cs-jtbd__label">WHY THIS MATTERS</p>
                <p class="cs-jtbd__text">Only 3 of 8 competitor apps offered booking. Solved with a 10-minute hold</p>
              </span>
            </span>
          </button>
          <button type="button" class="cs-jtbd__card" aria-pressed="false">
            <span class="cs-jtbd__card-inner">
              <span class="cs-jtbd__card-face cs-jtbd__card-front">
                <p class="cs-jtbd__label">job 3</p>
                <p class="cs-jtbd__text">When starting a charge, I want to set custom limits by budget, percentage, or duration, so I stay in full control of my schedule and spending</p>
                <img src="/assets/energo/v2/jtbd-quote.svg" alt="" class="cs-jtbd__quote" aria-hidden="true" />
              </span>
              <span class="cs-jtbd__card-face cs-jtbd__card-back">
                <p class="cs-jtbd__label">WHY THIS MATTERS</p>
                <p class="cs-jtbd__text">Drivers think in money, kWh, %, or minutes, never one unit. Solved with 4 limit modes</p>
              </span>
            </span>
          </button>
          <button type="button" class="cs-jtbd__card" aria-pressed="false">
            <span class="cs-jtbd__card-inner">
              <span class="cs-jtbd__card-face cs-jtbd__card-front">
                <p class="cs-jtbd__label">job 4</p>
                <p class="cs-jtbd__text">When selecting a location, I want transparent pricing and live station availability upfront, so I can choose the most cost-effective open slot</p>
                <img src="/assets/energo/v2/jtbd-quote.svg" alt="" class="cs-jtbd__quote" aria-hidden="true" />
              </span>
              <span class="cs-jtbd__card-face cs-jtbd__card-back">
                <p class="cs-jtbd__label">WHY THIS MATTERS</p>
                <p class="cs-jtbd__text">Price and status were the first things drivers checked. Solved with both on every card</p>
              </span>
            </span>
          </button>
        </div>
      </div>
    </section>

    <!-- ── Customer journey ── -->
    <section class="cs-page">
      <div class="cs-stack" style="gap:80px;">
        <div class="cs-heading-pair">
          <p class="cs-section-heading">Every pain answered</p>
          <p class="cs-subheading">Customer journey</p>
        </div>
        <div class="cs-cjm">
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Low Battery</p>
            <p class="cs-cjm__pain">Range anxiety</p>
            <p class="cs-cjm__fix">→ Live map surfaces<br>the nearest options</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Search</p>
            <p class="cs-cjm__pain">Which one is free?</p>
            <p class="cs-cjm__fix">→ Status is hidden or stale</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Decide</p>
            <p class="cs-cjm__pain">Fear of a taken spot</p>
            <p class="cs-cjm__fix">→ Charge % shown<br>on busy connectors</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Reserve</p>
            <p class="cs-cjm__pain">No certainty</p>
            <p class="cs-cjm__fix">→ Book a connector,<br>10-minute hold</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Travel</p>
            <p class="cs-cjm__pain">Getting there</p>
            <p class="cs-cjm__fix">→ One-tap route<br>in your navigator</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Connect</p>
            <p class="cs-cjm__pain">Which connector?</p>
            <p class="cs-cjm__fix">→ Guided in-flow</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Charge</p>
            <p class="cs-cjm__pain">How much, how long?</p>
            <p class="cs-cjm__fix">→ Charge % shown<br>on busy connectors</p>
          </div>
          <div class="cs-cjm__stage">
            <p class="cs-cjm__tag">Pay &amp; Leave</p>
            <p class="cs-cjm__pain">Stuck balances</p>
            <p class="cs-cjm__fix">→ Auto-pay + receipt</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── User flow ── -->
    <section class="cs-page">
      <div class="cs-flow-section">
        <div class="cs-stack cs-flow-section__inner" style="gap:160px;">
          <div class="cs-heading-pair">
            <p class="cs-section-heading">The core path, end to end</p>
            <p class="cs-subheading">User flow</p>
          </div>
          <div class="cs-flow">
            <span class="cs-flow__step">Open app</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step cs-flow__step--active">Map · online / free</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step">Pick station</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step cs-flow__step--active">Book connector</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step">Route</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step">Scan / select connector</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step cs-flow__step--active">Set limit · money · kWh · % · time</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step">Charge · live status</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step cs-flow__step--active">Auto-pay from wallet</span>
            <span class="cs-flow__arrow">→</span>
            <span class="cs-flow__step">Receipt</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Wireframes ── -->
    <section class="cs-page">
      <div class="cs-stack" style="gap:80px;">
        <div class="cs-heading-pair">
          <p class="cs-section-heading">Structure before style</p>
          <p class="cs-subheading">Wireframes</p>
        </div>
        <div class="cs-wireframes">
          <div class="cs-wireframes__card">
            <img src="/assets/energo/v2/wf-find-station.png" alt="Find a station wireframe" />
            <p>Find a station</p>
          </div>
          <div class="cs-wireframes__card">
            <img src="/assets/energo/v2/wf-pick-station.png" alt="Pick a station wireframe" />
            <p>Pick a station</p>
          </div>
          <div class="cs-wireframes__card">
            <img src="/assets/energo/v2/wf-pick-connector.png" alt="Pick a connector wireframe" />
            <p>Pick a connector</p>
          </div>
          <div class="cs-wireframes__card">
            <img src="/assets/energo/v2/wf-setup-charge.png" alt="Set up the charge wireframe" />
            <p>Set up the charge</p>
          </div>
          <div class="cs-wireframes__card">
            <img src="/assets/energo/v2/wf-connecting.png" alt="Connecting wireframe" />
            <p>Connecting</p>
          </div>
          <div class="cs-wireframes__card">
            <img src="/assets/energo/v2/wf-charging.png" alt="Charging wireframe" />
            <p>Charging</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── From findings to screens ── -->
    <section class="cs-page">
      <div class="cs-stack" style="gap:80px;">
        <div class="cs-heading-pair">
          <p class="cs-section-heading">From findings to screens</p>
          <p class="cs-subheading">Designing the flows</p>
        </div>
        <div class="cs-editorial">
          <div class="cs-editorial__row">
            <div class="cs-editorial__frame"><video src="/assets/energo/v2/screens/onboarding.webm" autoplay muted loop playsinline aria-label="Onboarding screen recording"></video></div>
            <div class="cs-editorial__text">
              <p class="cs-editorial__tag">Onboarding</p>
              <p class="cs-editorial__title">Phone number, and nothing else</p>
              <p class="cs-editorial__desc">Just phone + OTP. No password, no PIN. Competitors stacked all three and lost users at the door</p>
            </div>
          </div>
          <div class="cs-editorial__row cs-editorial__row--reverse">
            <div class="cs-editorial__frame"><video src="/assets/energo/v2/screens/home-map-list.webm" autoplay muted loop playsinline aria-label="Home map and list screen recording"></video></div>
            <div class="cs-editorial__text">
              <p class="cs-editorial__tag">Home · Map &amp; list</p>
              <p class="cs-editorial__title">Availability is the product</p>
              <p class="cs-editorial__desc">Map and list share the same live data, one swipe apart, because drivers split 50/50 on how they search. Filters ask only what matters: connector, power, online, free</p>
            </div>
          </div>
          <div class="cs-editorial__row">
            <div class="cs-editorial__frame"><video src="/assets/energo/v2/screens/booking.webm" autoplay muted loop playsinline aria-label="Booking screen recording"></video></div>
            <div class="cs-editorial__text">
              <p class="cs-editorial__tag">Booking</p>
              <p class="cs-editorial__title">Designed against the occupied station</p>
              <p class="cs-editorial__desc">Reserve a connector, watch the countdown, arrive certain. Only 3 of 8 competitors offered this at all</p>
            </div>
          </div>
          <div class="cs-editorial__row cs-editorial__row--reverse">
            <div class="cs-editorial__frame"><video src="/assets/energo/v2/screens/order.webm" autoplay muted loop playsinline aria-label="Order screen recording"></video></div>
            <div class="cs-editorial__text">
              <p class="cs-editorial__tag">Order</p>
              <p class="cs-editorial__title">Four ways to say how much</p>
              <p class="cs-editorial__desc">Drivers think in money, kWh, percent, or minutes. The screen speaks all four, plus one-tap "charge to 100%". One simple choice, not a settings panel</p>
            </div>
          </div>
          <div class="cs-editorial__row">
            <div class="cs-editorial__frame"><video src="/assets/energo/v2/screens/wallet-payments.webm" autoplay muted loop playsinline aria-label="Wallet and payments screen recording"></video></div>
            <div class="cs-editorial__text">
              <p class="cs-editorial__tag">Wallet &amp; payments</p>
              <p class="cs-editorial__title">A wallet that speaks the local rails</p>
              <p class="cs-editorial__desc">Top up through Click, HUMO, or Uzcard, with no punishing minimums and the balance always visible. Every session settles cleanly, so drivers never wonder where their money went</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Typography & Colors ── -->
    <section class="cs-page">
      <div class="cs-stack" style="gap:80px;">
        <p class="cs-section-heading">Typography &amp; Colors</p>
        <div class="cs-stack" style="gap:20px;">
          <div class="cs-tokens__row">
            <div class="cs-tokens__ramp">
              <div style="background:#f4fbf5;"></div>
              <div style="background:#caedcd;"></div>
              <div style="background:#a4e0a9;"></div>
              <div style="background:#53c45d;"></div>
              <div style="background:#2bb637;"></div>
              <div style="background:#22922c;"></div>
              <div style="background:#1a6d21;"></div>
              <div style="background:#114916;"></div>
            </div>
            <div class="cs-tokens__type-card">
              <div class="cs-tokens__weights">
                <p>Medium</p><p>Semibold</p><p>Bold</p>
              </div>
              <p class="cs-tokens__specimen">Inter</p>
            </div>
            <div class="cs-tokens__sample">
              AaBbCc<br />01234567<br />{`{(!@#$%&*?)}`}
            </div>
          </div>
          <div class="cs-tokens__swatches">
            <div style="background:#ffffff; color:#0f1012;"><span>#FFFFFF</span></div>
            <div style="background:#f5f5f5; color:#0f1012;"><span>#F5F5F5</span></div>
            <div style="background:#2bb637; color:#fff;"><span>#2BB637</span></div>
            <div style="background:#4e81ef; color:#fff;"><span>#4E81EF</span></div>
            <div style="background:#111827; color:#fff;"><span>#111827</span></div>
            <div style="background:#0f1012; color:#f5f5f5;"><span>#0F1012</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Components ── -->
    <section class="cs-page">
      <div class="cs-stack" style="gap:80px;">
        <p class="cs-section-heading">Core Components</p>
        <div class="cs-components">
          <div class="cs-components__col">
            <div class="cs-components__card cs-components__card--tall">
              <p class="cs-components__label">Connectors</p>
              <img src="/assets/energo/v2/comp-recipe1-v2.png" alt="Select connector bottom sheet component" class="cs-components__recipe-img" />
            </div>
          </div>
          <div class="cs-components__col">
            <div class="cs-components__row">
              <div class="cs-components__card">
                <div class="cs-components__content">
                  <img src="/assets/energo/v2/comp-charging-v3.png" alt="Live charging session gauge" class="cs-components__charging-img" />
                </div>
                <p class="cs-components__label">Live Session</p>
              </div>
              <div class="cs-components__card">
                <div class="cs-components__content">
                  <img src="/assets/energo/v2/comp-recipe2-v2.png" alt="Recipe component" class="cs-components__recipe-img2" />
                </div>
                <p class="cs-components__label">Invoice</p>
              </div>
              <div class="cs-components__card">
                <div class="cs-components__content">
                  <div class="cs-components__statuses">
                    <img src="/assets/energo/v2/comp-status-available-img.png" alt="Available status badge" class="cs-components__status-badge" />
                    <img src="/assets/energo/v2/comp-status-connected-img.png" alt="Connected status badge" class="cs-components__status-badge" />
                    <img src="/assets/energo/v2/comp-status-reserved-img.png" alt="Reserved status badge" class="cs-components__status-badge" />
                    <img src="/assets/energo/v2/comp-status-unavailable-img.png" alt="Unavailable status badge" class="cs-components__status-badge" />
                  </div>
                </div>
                <p class="cs-components__label">Status Badges</p>
              </div>
            </div>
            <div class="cs-components__row">
              <div class="cs-components__card cs-components__card--short">
                <div class="cs-components__content">
                  <img src="/assets/energo/v2/comp-active-booking-v3.png" alt="Active booking station item" class="cs-components__booking-img" />
                </div>
                <p class="cs-components__label">Active Booking</p>
              </div>
              <div class="cs-components__card cs-components__card--short">
                <div class="cs-components__content">
                  <img src="/assets/energo/v2/comp-tabbar-v2.png" alt="Tab bar component" class="cs-components__tabbar-img" />
                </div>
                <p class="cs-components__label">Navigation Bar</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Closing ── -->
    <section class="cs-page cs-page--closing">
      <div class="cs-closing">
        <div class="cs-closing__spacer"></div>
        <p class="cs-closing__text">Thanks</p>
        <button type="button" class="cs-closing__heart-btn" aria-label="Send some love">
          <img src="/assets/energo/v2/icon-heart-v3.svg" alt="" class="cs-closing__heart" />
        </button>
        <p class="cs-closing__text">for watching</p>
      </div>
    </section>

  </main>

  <Fragment slot="scripts">
    <script is:inline>
      // ── Section entrance: items fade up as they scroll into view ─
      function getAnimItems(section) {
        const items = [], seen = new Set();
        function add(el) { if (el && !seen.has(el)) { seen.add(el); items.push(el); } }

        section.querySelectorAll('.cs-row').forEach(row => {
          Array.from(row.children).forEach(child => {
            if (child.classList.contains('cs-col-left')) {
              if (child.childElementCount > 0) add(child);
            } else if (child.classList.contains('cs-col-right')) {
              Array.from(child.children).forEach(add);
            } else {
              add(child);
            }
          });
        });

        section.querySelectorAll('.cs-visual-row, .cs-process, .cs-cjm, .cs-wireframes, .cs-editorial__row, .cs-tokens__row, .cs-tokens__swatches, .cs-components, .cs-closing').forEach(el => {
          if (!el.closest('.cs-row')) add(el);
        });

        // The flow steps reveal one by one, left to right, rather than
        // as a single block — see the --reveal-delay assignment below.
        section.querySelectorAll('.cs-flow__step, .cs-flow__arrow').forEach(add);

        return items;
      }

      const animItems = [];
      [...document.querySelectorAll('.cs-page')].slice(1).forEach(section => {
        animItems.push(...getAnimItems(section));
      });
      // Jobs To Be Done lives in its own full-bleed section (not .cs-page,
      // since it's a different background/layout), so its cards are
      // gathered separately.
      animItems.push(...document.querySelectorAll('.cs-jtbd__heading, .cs-jtbd__card'));

      document.querySelectorAll('.cs-flow').forEach(flow => {
        [...flow.children].forEach((el, i) => el.style.setProperty('--reveal-delay', `${i * 40}ms`));
      });

      observeReveal(animItems, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

      // The shared Footer component ships with its own opacity:0 base
      // style (style.css) meant to be cleared by observeReveal — the
      // homepage does this itself, so this page must too.
      const footerEl = document.querySelector('.footer');
      if (footerEl) observeReveal([footerEl], { threshold: 0.04 });

      // ── Parallax on hero visual images ────────────
      // The EnerGo wordmark overlay stays put; only the product photo and
      // phone-mockup images shift as you scroll past the panel. The
      // editorial screen recordings get the same scroll parallax, but
      // start from a centering transform (they're absolutely centered
      // in their frame) that has to be preserved alongside it.
      const parallaxEls = [
        ...[...document.querySelectorAll('.cs-visual-product, .cs-visual-phone')]
          .map(el => ({ el, panel: el.closest('.cs-visual-panel'), amount: 50, center: false })),
        ...[...document.querySelectorAll('.cs-editorial__frame img, .cs-editorial__frame video')]
          .map(el => ({ el, panel: el.closest('.cs-editorial__frame'), amount: 30, center: true })),
      ];

      function updateVisualParallax() {
        const vh = window.innerHeight;
        parallaxEls.forEach(({ el, panel, amount, center }) => {
          const rect = panel.getBoundingClientRect();
          const progress = (rect.top + rect.height / 2 - vh / 2) / vh;
          const base = center ? 'translate(-50%, -50%) ' : '';
          el.style.transform = `${base}translateY(${progress * amount}px) scale(var(--hover-scale, 1))`;
        });
      }
      window.lenis.on('scroll', updateVisualParallax);
      updateVisualParallax();

      // ── JTBD card flip ─────────────────────────────
      document.querySelectorAll('.cs-jtbd__card').forEach(card => {
        card.addEventListener('click', () => {
          card.setAttribute('aria-pressed', card.getAttribute('aria-pressed') !== 'true');
        });
        card.addEventListener('mouseleave', () => {
          card.setAttribute('aria-pressed', 'false');
        });
      });

      // ── Closing heart burst ────────────────────────
      const heartBtn = document.querySelector('.cs-closing__heart-btn');
      if (heartBtn) {
        heartBtn.addEventListener('click', () => {
          const count = 8;
          for (let i = 0; i < count; i++) {
            const particle = document.createElement('span');
            particle.className = 'cs-closing__particle';
            const angle = (Math.PI * 2 * i) / count + (Math.random() * 0.4 - 0.2);
            const distance = 60 + Math.random() * 40;
            particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
            particle.style.setProperty('--dy', `${Math.sin(angle) * distance - 20}px`);
            particle.style.animationDelay = `${Math.random() * 80}ms`;
            heartBtn.appendChild(particle);
            particle.addEventListener('animationend', () => particle.remove());
          }
        });
      }
    </script>
